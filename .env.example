# База УСП (self-hosted Supabase); адрес можно переопределить в приложении:
# Профиль → ⚙️.
#
# Данные УСП лежат в схеме `erp`, собственные таблицы мобилки — в `mobile`.
# Обе открыты в PostgREST, клиент выбирает схему через supabase.schema(...).
# Внимание: порт 9001 на сервере УСП — это фронтенд, API слушает на 8080.
EXPO_PUBLIC_SUPABASE_URL=http://91.147.81.4:8080
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Сервис подписания документов ЭЦП (принимает .p12 + пароль).
# Без этой переменной кнопка «Подписать ЭЦП» отключена — приложение
# не отправит закрытый ключ на неизвестный хост.
EXPO_PUBLIC_SIGN_SERVICE_URL=https://sign.asgroup.az/sign_doc/
